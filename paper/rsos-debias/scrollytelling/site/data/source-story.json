{"metadata":{"title":"The same place looks different through different data","analysis_area":"England and Wales","geography":"331 local authority districts using 2021 boundaries","area_count":331,"source_count":4,"switch_count":300,"consistent_below_count":22,"consistent_above_count":9,"exact_switch_predicate":"minimum ratio_to_fitted across the four sources < 1 AND maximum ratio_to_fitted across the four sources > 1","input_sha256":"e8e6d0bc4b9bb146f713c9ce6ab882316569a79d4664a9e7e7b0dcf29804e7a8","source_order":["twitter_x","meta","multiapp1","multiapp2"],"side_pattern_encoding":"Four characters in source_order: A = above, B = below, F = exactly at the fitted rate","metric":{"public_name":"Relative local coverage index","field_name":"ratio_to_fitted","formula":"(local source count / 2021 Census resident population) / fitted through-origin source rate","fitted_model":"source_count_i = alpha_source * census_population_i","baseline":1,"below_label":"Below that source's fitted proportional rate","above_label":"Above that source's fitted proportional rate","interpretation":"A value of 1 lies on that source's fitted proportional line. Values below or above 1 indicate fewer or more observed identifiers per resident than that source's fitted rate."},"predicates":{"below":"ratio_to_fitted < 1","above":"ratio_to_fitted > 1","switch":"minimum ratio_to_fitted across sources < 1 AND maximum ratio_to_fitted across sources > 1","consistent_below":"maximum ratio_to_fitted across sources < 1","consistent_above":"minimum ratio_to_fitted across sources > 1"},"inputs":{"released_lad_counts":{"path":"outputs/manuscript-data/lad-derived-population-counts.csv","sha256":"e8e6d0bc4b9bb146f713c9ce6ab882316569a79d4664a9e7e7b0dcf29804e7a8"},"lad_code_lookup":{"path":"paper/rsos-debias/scrollytelling/site/data/meta-story.json","sha256":"e34c57038a2eabbb8e59a0eb213a5279a12dcca8b3636ce04d45bc8f7137a12b"}},"caveats":["Source numerators differ: active accounts, aggregate active-account estimates,